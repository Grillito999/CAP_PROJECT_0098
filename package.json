{
  "name": "CAP_PROJECT",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2.8.0",
    "@sap/cds": "^9.9.3",
    "@sap/xssec": "^4.13.3",
    "express": "^5.2.1",
    "sqlite": "^5.1.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-salesorders": "cds watch --open salesorders/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/salesorders"
  ]
}
